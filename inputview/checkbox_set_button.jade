.pull-right.checkbox-set-buttons
  .btn-group
    a.btn.btn-info(data-toggle='tooltip', title='edit the checkbox') Edit
    a.btn.btn-warning(data-toggle='tooltip', title='remove the checkbox') Remove
    a.btn(data-toggle='tooltip', title='move the checkbox up') Up
    a.btn(data-toggle='tooltip', title='move the checkbox down') Down