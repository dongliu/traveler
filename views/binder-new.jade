extends layout

block head
  meta(charset='urf-8')
  title #{orgName} - new binder
  meta(name='viewport', content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet', href='#{prefix}/bootstrap/css/bootstrap.css')
  link(rel='stylesheet', href='#{prefix}/bootstrap/css/bootstrap-responsive.css')
  link(rel='stylesheet', href='#{prefix}/stylesheets/style.css')

block content
  .container(style="margin-top: 10px")
    form.form-horizontal(name='newbinder', action='./', method='POST')
      .control-group
        .control-label Binder title
        .controls
          input(type='text', name='title', required)
      .control-group
        .control-label Description
        .controls
          input(type='text', name='description')
      .control-group
        .controls
          .btn-group
            button.btn.btn-primary(type='submit') Confirm
          .btn-group
            button.btn(onclick='window.open("", "_self", ""); window.close(); return false;') Cancel


block js
  script(type='text/javascript', src='#{prefix}/jquery-3.7.1/jquery-3.7.1.min.js')
  script(type='text/javascript', src='#{prefix}/jquery-3.7.1/jquery-migrate-3.6.0.js')
  script(type='text/javascript', src='#{prefix}/jquery-ui-1.14.2.custom/jquery-ui.min.js')
  script(type='text/javascript', src='#{prefix}/bootstrap-3.4.1-dist/js/bootstrap.min.js')
