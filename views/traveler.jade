extends default-buttons

block head
  meta(charset='utf-8')
  title #{orgName} - traveler - #{traveler._id}
  meta(name='viewport', content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet', href='#{prefix}/bootstrap/css/bootstrap.css')
  link(rel='stylesheet', href='#{prefix}/bootstrap/css/bootstrap-responsive.css')
  link(rel='stylesheet', href='#{prefix}/font-awesome-4.3.0/css/font-awesome.css')
  link(rel='stylesheet', href='#{prefix}/stylesheets/style.css')

block bodyJs
  script(type='text/javascript').
    var traveler = !{JSON.stringify(traveler)};
    var travelerStatus = !{JSON.stringify(traveler.status)};
    var finishedInput = !{JSON.stringify(traveler.finishedInput)};
    var totalInput = !{JSON.stringify(traveler.totalInput)};
    var title = !{JSON.stringify(traveler.title)};
block underTopBtn
  .container
    #message
    #modal.modal.hide.fade(tabindex='-1',role='dialog',data-backdrop='static',aria-labelledby='modalLabel',aria-hidden='true')
      .modal-header
        h3#modalLabel
      .modal-body
      .modal-footer
    .row
      .span9
        h3 Traveler title:  !{traveler.title}
        h4 Document No.:    !{traveler.documentNumber}
        h4 Part No.:        !{traveler.tags.join(', ')}
        include ./traveler/status.jade
        if (traveler.devices && traveler.devices.length > 0)
          h4 Serial Numbers: !{traveler.devices}
        if (traveler.referenceReleasedFormVer)
          h4 #{viewConfig.terminology.form} version: #{traveler.referenceReleasedFormVer}
        //- if (locals.traveler.status !== undefined)
        if (isOwner || isAdmin || isManager || canStart)
          case traveler.status
            when 0
              .btn-group
                button.btn.btn-primary#work Start to work
            when 1
              .btn-group
                button.btn.btn-primary#complete Submit for completion
            when 2
              .btn-group
                a.btn.btn-primary#pdf(data-toggle='tooltip', title='create pdf in print view', href='print', target='#{viewConfig.linkTarget}') Create PDF

        //- show review results if any
        if ( (traveler.status === 0 || traveler.status === 1.5 || traveler.status === 2 || traveler.status === 4) && review)
          h4 Reviews
          if (traveler.status === 2)
            p The traveler was completed.
          #reviews.accordion
            .accordion-group
              .accordion-heading
                a.accordion-toggle(data-toggle="collapse" data-parent="#reviews" href="#review-results") Completed review(s)
              #review-results.accordion-body.collapse
                .accordion-inner
                  each result in review.reviewResults
                    accordion(id="#{result._id}")
                      .accordion-group
                        .accordion-heading
                          a.accordion-toggle(data-toggle="collapse" data-parent="#{result._id}" href="\##{result._id}-comment") #{result.reviewerName || result.reviewerId}
                            | &nbsp;
                            if (result.result === "1")
                              b approved
                            else
                              b rejected
                            | &nbsp;on&nbsp;
                            span.time #{result.submittedOn}
                            | &nbsp;for version #{result.v}
                        .accordion-body.collapse(id="#{result._id}-comment")
                          .accordion-inner
                            span #{result.comment}
            if (isReviewer && traveler.status === 1.5)
              .accordion-group
                .accordion-heading
                  a.accordion-toggle(data-toggle="collapse" data-parent="#reviews" href="#new-review") Submit the review
                #new-review.accordion-body.collapse
                  .accordion-inner
                    form.form-horizontal#review
                      .control-group
                        .controls
                          label.radio
                            input#approve(type="radio" name="result" value="1")
                            span Approve completion
                          label.radio
                            input#non-approve(type="radio" name="result" value="2")
                            span Reject completion
                      .control-group
                        .control-label comment
                        .controls
                          textarea#comment(name="comment", cols="40", rows="10")
                      .btn-group
                        button.btn.btn-primary#submit-review(data-toggle='tooltip', title='Report review result') Submit

        if (traveler.status === 0 || traveler.status === 1 || traveler.status === 1.5)
          br
          .btn-group
            button.btn.btn-info(data-toggle='collapse', data-target='#details') Details
          .btn-group
            //- if (locals.isOwner != undefined && (locals.isOwner || isAdmin))
            a(href="config")
              button.btn.btn-primary Configuration
        #validation.well.hide
        #details.collapse.out
          //- if (locals.traveler.referenceReleasedForm)
            h4
              span Created from:
              a(href='#{prefix}/released-forms/#{locals.traveler.referenceReleasedForm}/', target='#{viewConfig.linkTarget}') Released #{viewConfig.terminology.form}
          if (traveler.description !== undefined)
            h4 Description: #{traveler.description}
          //- if (locals.traveler.deadline !== undefined)
          //-   p Deadline:
          //-     = ' '
          //-     span.time #{traveler.deadline}
          p Created by #{traveler.createdBy}
            = ' '
            if (traveler.clonedBy !== undefined)
              | cloned by #{traveler.clonedBy} on
            else
              | on
            = ' '
            span.time #{traveler.createdOn}
          if (traveler.updatedBy !== undefined)
            p Updated by #{traveler.updatedBy} on
              = ' '
              span.time #{traveler.updatedOn}
        br
        if traveler.activeDiscrepancyForm
          .control-group#discrepancy-legend
            legend Discrepancy log
          table#discrepancy-log-table.table.table-bordered.table-hover
          if (traveler.status === 1 || traveler.forms.length === 1.5)
            .btn-group
              button.btn.btn-primary#add-discrepancy Add discrepancy log
        form.form-horizontal#form
          div.control-group#traveler-legend
            legend Traveler
          if (traveler.forms.length === 1)
            != traveler.forms[0].html
          else if (traveler.forms.id(traveler.activeForm))
            != traveler.forms.id(traveler.activeForm).html
          else
            != ''
        if (locals.traveler.status === 1)
          .btn-group
            button.btn.btn-primary#complete2 Submit for completion
      .span3.sidebar

block js
  script(type='text/javascript', src='#{prefix}/jquery-3.7.1/jquery-3.7.1.min.js')
  script(type='text/javascript', src='#{prefix}/jquery-3.7.1/jquery-migrate-3.6.0.js')
  script(type='text/javascript', src='#{prefix}/dependencies/lodash.js')
  script(type='text/javascript', src='#{prefix}/bootstrap-3.4.1-dist/js/bootstrap.min.js')
  script(type='text/javascript', src='#{prefix}/datatables/js/jquery.dataTables.js')
  script(type='text/javascript', src='#{prefix}/datatables/js/dataTables.bootstrap.js')
  script(type='text/javascript', src='#{prefix}/dependencies/modernizr.js')
  script(type='text/javascript', src='#{prefix}/dependencies/binder.js')
  script(type='text/javascript', src='#{prefix}/dependencies/moment.js')
  script(type='text/javascript', src='#{prefix}/dependencies/livestamp.js')
  script(type='text/javascript', src='#{prefix}/bootstrap-datepicker/js/bootstrap-datepicker.js')
  script(type='text/javascript', src='#{prefix}/javascripts/table.js')
  script(type='text/javascript', src='#{prefix}/javascripts/ajax-helper.js')
  script(type='text/javascript', src='#{prefix}/javascripts/util.js')
  script(type='text/javascript', src='#{prefix}/javascripts/validation.js')
  script(type='text/javascript', src='#{prefix}/javascripts/traveler-discrepancy-form-loader.js')
  script(type='text/javascript', src='#{prefix}/javascripts/tracking.js')
  script(type='module', src='#{prefix}/javascripts/traveler.js')
