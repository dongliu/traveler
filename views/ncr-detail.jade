extends layout

block head
  meta(charset='utf-8')
  title #{ncr.ncr_number} — #{ncr.status}
  meta(name='viewport', content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet', href='#{prefix}/bootstrap/css/bootstrap.css')
  link(rel='stylesheet', href='#{prefix}/bootstrap/css/bootstrap-responsive.css')
  link(rel='stylesheet', href='#{prefix}/stylesheets/style.css')
  style.
    .event-timeline { border-left: 3px solid #ddd; padding-left: 15px; margin-top: 10px; }
    .event-entry { margin-bottom: 12px; position: relative; }
    .event-entry::before { content: ''; width: 10px; height: 10px; background: #999; border-radius: 50%; position: absolute; left: -19px; top: 4px; }
    .badge-Submitted { background-color: #5bc0de; }
    .badge-Dispositioned { background-color: #f0ad4e; }
    .badge-ApprovalRequested { background-color: #5cb85c; }
    .badge-Returned { background-color: #d9534f; }
    .badge-Final { background-color: #428bca; }
    .badge-Closed { background-color: #777; }

block content
  small#ncr-live-updated.muted.pull-right
  #ncr-page-body
    include ncr-detail-body.jade

block js
  script(type='text/javascript', src='#{prefix}/jquery-3.7.1/jquery-3.7.1.min.js')
  script(type='text/javascript', src='#{prefix}/javascripts/jquery-migrate-config.js')
  script(type='text/javascript', src='#{prefix}/jquery-3.7.1/jquery-migrate-3.6.0.js')
  script(type='text/javascript', src='#{prefix}/bootstrap/js/bootstrap.min.js')
  script(type='text/javascript', src='#{prefix}/dependencies/typeahead.bundle.js')
  script(type='text/javascript', src='#{prefix}/javascripts/global.js')
  script(type='text/javascript', src='#{prefix}/javascripts/usernames.js')
  script(type='text/javascript').
    (function($) {
      var ncrId = '#{ncr._id}';
      var apiBase = '#{prefix}/api/ncrs/' + ncrId + '/preventive-actions';

      function showPaError(msg) {
        $('#pa-error-msg').text(msg);
        $('#pa-error').show();
        setTimeout(function() { $('#pa-error').hide(); }, 5000);
      }

      function getPaWell(btn) {
        return $(btn).closest('.well');
      }

      function getPaId(btn) {
        return getPaWell(btn).data('pa-id');
      }

      $(document).on('click', '.pa-assign-btn', function() {
        var $well = getPaWell(this);
        $well.find('.pa-assign-form').toggle();
        $well.find('.pa-update-form').hide();
      });

      $(document).on('click', '.pa-update-btn', function() {
        var $well = getPaWell(this);
        $well.find('.pa-update-form').toggle();
        $well.find('.pa-assign-form').hide();
      });

      $(document).on('click', '.pa-cancel', function() {
        getPaWell(this).find('.pa-assign-form, .pa-update-form').hide();
      });

      $(document).on('click', '.pa-assign-submit', function() {
        var $well = getPaWell(this);
        var paId = getPaId(this);
        var payload = {
          owner_id: $well.find('.pa-owner-id').val().trim(),
          owner_name: $well.find('.pa-owner-name').val().trim(),
          owner_email: $well.find('.pa-owner-email').val().trim(),
          target_completion_date: $well.find('.pa-target-date').val()
        };
        if (!payload.owner_id || !payload.owner_name || !payload.owner_email || !payload.target_completion_date) {
          return showPaError('All owner fields are required.');
        }
        $.ajax({
          url: apiBase + '/' + paId + '/owner',
          method: 'PATCH',
          contentType: 'application/json',
          data: JSON.stringify(payload),
          success: function() { location.reload(); },
          error: function(xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to assign owner.';
            showPaError(msg);
          }
        });
      });

      $(document).on('click', '.pa-update-submit', function() {
        var $well = getPaWell(this);
        var paId = getPaId(this);
        var payload = {
          action: 'update',
          status: $well.find('.pa-new-status').val(),
          comment: $well.find('.pa-comment').val().trim()
        };
        $.ajax({
          url: apiBase + '/' + paId + '/status',
          method: 'PATCH',
          contentType: 'application/json',
          data: JSON.stringify(payload),
          success: function() { location.reload(); },
          error: function(xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to update status.';
            showPaError(msg);
          }
        });
      });

      $(document).on('click', '#timeline-toggle', function(e) {
        e.preventDefault();
        var $tl = $('#event-timeline');
        if ($tl.is(':visible')) {
          $tl.hide();
          $(this).text('Show');
        } else {
          $tl.show();
          $(this).text('Hide');
        }
      });

      $(document).on('click', '.event-payload-toggle', function(e) {
        e.preventDefault();
        $(this).next('.event-payload').toggle();
      });

      $(document).on('click', '.pa-close-btn', function() {
        var paId = getPaId(this);
        if (!confirm('Close this preventive action?')) return;
        $.ajax({
          url: apiBase + '/' + paId + '/status',
          method: 'PATCH',
          contentType: 'application/json',
          data: JSON.stringify({ action: 'close' }),
          success: function() { location.reload(); },
          error: function(xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to close PA.';
            showPaError(msg);
          }
        });
      });

      if (typeof travelerGlobal !== 'undefined' && travelerGlobal.usernames) {
        travelerGlobal.usernames.initialize();
        $('#designate-name-input').typeahead(
          { minLength: 1, highlight: true, hint: true },
          { name: 'usernames', display: 'displayName', limit: 20, source: travelerGlobal.usernames }
        );
      }

      function showDesignateError(msg) {
        $('#designate-error-msg').text(msg);
        $('#designate-error').show();
      }

      // The typeahead dropdown renders directly below #designate-name-input
      // and can still be open (visually overlapping Save/Cancel, which sit
      // immediately below the field) when those buttons are clicked, since
      // this form has no other field to blur through first. Close it on
      // mousedown (which fires before click) so the buttons are reliably
      // clickable on the first attempt.
      $(document).on('mousedown', '#designate-submit-btn, #designate-cancel-btn', function() {
        $('#designate-name-input').typeahead('close');
      });

      $(document).on('click', '#designate-toggle', function(e) {
        e.preventDefault();
        $('#designate-error').hide();
        $('#designate-form').toggle();
      });

      $(document).on('click', '#designate-cancel-btn', function() {
        $('#designate-form').hide();
        $('#designate-error').hide();
      });

      $(document).on('click', '#designate-submit-btn', function() {
        var name = $('#designate-name-input').val().trim();
        var users = (typeof travelerGlobal !== 'undefined' && travelerGlobal.usernames)
          ? travelerGlobal.usernames.get(name)
          : [];
        if (!users || users.length === 0) {
          return showDesignateError('Designate must be selected from the list.');
        }
        var designateUser = users[0];
        $.ajax({
          url: '#{prefix}/api/ncrs/#{ncr._id}/designate',
          method: 'PATCH',
          contentType: 'application/json',
          data: JSON.stringify({
            designate_id: designateUser.uid,
            designate_name: name,
            designate_email: designateUser.mail
          }),
          success: function() { location.reload(); },
          error: function(xhr) {
            var resp = xhr.responseJSON || {};
            showDesignateError(resp.message || resp.error || 'Failed to assign Designate.');
          }
        });
      });

      $(document).on('click', '#designate-remove-btn', function() {
        if (!confirm('Remove the current Designate from this NCR?')) return;
        $.ajax({
          url: '#{prefix}/api/ncrs/#{ncr._id}/designate',
          method: 'PATCH',
          contentType: 'application/json',
          data: JSON.stringify({}),
          success: function() { location.reload(); },
          error: function(xhr) {
            var resp = xhr.responseJSON || {};
            showDesignateError(resp.message || resp.error || 'Failed to remove Designate.');
          }
        });
      });

      if (typeof travelerGlobal !== 'undefined' && travelerGlobal.usernames) {
        $('#new-approver-id').typeahead(
          { minLength: 1, highlight: true, hint: true },
          { name: 'usernames', display: 'displayName', limit: 20, source: travelerGlobal.usernames }
        );
      }

      function showApproverMgmtError(msg) {
        $('#approver-mgmt-error-msg').text(msg);
        $('#approver-mgmt-error').show();
      }

      $(document).on('mousedown', '#add-approver-btn', function() {
        $('#new-approver-id').typeahead('close');
      });

      $(document).on('click', '#add-approver-btn', function() {
        var input = $('#new-approver-id').val().trim();
        if (!input) return;
        var id = input;
        var name = input;
        var email = '';
        var users = (typeof travelerGlobal !== 'undefined' && travelerGlobal.usernames)
          ? travelerGlobal.usernames.get(input)
          : [];
        if (users && users.length > 0) {
          id = users[0].uid;
          name = users[0].displayName;
          email = users[0].mail;
        }

        $('#approver-mgmt-error').hide();
        var btn = $(this);
        btn.prop('disabled', true);
        $.ajax({
          url: '#{prefix}/api/ncrs/#{ncr._id}/approvers',
          method: 'POST',
          contentType: 'application/json',
          data: JSON.stringify({ approver_id: id, approver_name: name, approver_email: email }),
          success: function() { location.reload(); },
          error: function(xhr) {
            var resp = xhr.responseJSON || {};
            showApproverMgmtError(resp.message || resp.error || 'Failed to add approver.');
            btn.prop('disabled', false);
          }
        });
      });

      $(document).on('click', '#approver-status-list .remove-approver-btn', function() {
        var approverId = $(this).data('approver-id');
        if (!confirm('Remove this approver from the NCR?')) return;

        $('#approver-mgmt-error').hide();
        var btn = $(this);
        btn.prop('disabled', true);
        $.ajax({
          url: '#{prefix}/api/ncrs/#{ncr._id}/approvers/' + encodeURIComponent(approverId),
          method: 'DELETE',
          success: function() { location.reload(); },
          error: function(xhr) {
            var resp = xhr.responseJSON || {};
            showApproverMgmtError(resp.message || resp.error || 'Failed to remove approver.');
            btn.prop('disabled', false);
          }
        });
      });
    })(jQuery);
  script(type='text/javascript').
    (function($) {
      var ncrId = '#{ncr._id}';
      // the revision the page was drawn with, as the live-status route reports it
      var liveRevision = [!{JSON.stringify(ncr.status)}, !{JSON.stringify(ncr.updated_at || null)}, !{JSON.stringify((ncr.events || []).length)}].join('|');

      function revisionOf(live) {
        return [live.status, live.updated_at, live.event_count].join('|');
      }

      // A form control that differs from how the page drew it, or a dialog that is open,
      // is an entry in progress: the body is not replaced over it (spec 125 FR-033).
      function isBusy() {
        var editing = $('#ncr-page-body').find('input, textarea').filter(function() {
          if (this.type === 'checkbox' || this.type === 'radio') {
            return this.checked !== this.defaultChecked;
          }
          return this.value !== this.defaultValue;
        }).length > 0;
        return editing || $('.modal:visible').length > 0;
      }

      function refreshBody(revision) {
        return $.ajax({
          url: '#{prefix}/ncrs/' + ncrId + '/fragment',
          type: 'GET',
          dataType: 'html',
        }).done(function(html) {
          if (isBusy()) {
            return; // an entry was started while the body was fetched: try again next time
          }
          $('#ncr-page-body').html(html);
          liveRevision = revision;
          $('#ncr-live-updated').text('Updated ' + new Date().toLocaleTimeString());
        });
      }

      function pollNcr() {
        return $.ajax({
          url: '#{prefix}/ncrs/' + ncrId + '/live-status',
          type: 'GET',
          dataType: 'json',
        }).done(function(live) {
          var revision = revisionOf(live);
          if (revision === liveRevision || isBusy()) {
            return;
          }
          refreshBody(revision);
        });
      }

      // the refresh is shared with the traveler page, so both pause and resume alike
      import('#{prefix}/javascripts/lib/live-refresh.js').then(function(mod) {
        mod.startLiveRefresh(pollNcr);
      });
    })(jQuery);
