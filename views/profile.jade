extends default-buttons

block head
  meta(charset='urf-8')
  title #{orgName} traveler - user profile
  meta(name='viewport', content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet', href='#{prefix}/bootstrap/css/bootstrap.css')
  link(rel='stylesheet', href='#{prefix}/bootstrap/css/bootstrap-responsive.css')
  link(rel='stylesheet', href='#{prefix}/jquery-ui-1.14.2.custom/jquery-ui.theme.css')
  link(rel='stylesheet', href='#{prefix}/stylesheets/style.css')

prepend topBtn
  .btn-group

block underTopBtn
  .container(style="margin-top: 10px")
    h3 My profile
    #profile.well
      dl
        dt Name
        dd #{user.name}
        dt Email
        dd #{user.email}
        dt Office
        dd #{user.office}
        dt Office phone
        dd #{user.phone}
        dt Mobile phone
        dd #{user.mobile}
        dt Last visited on
        dd #{user.lastVisitedOn}
        dt Roles
        dd #{user.roles}

block js
  script(type='text/javascript', src='#{prefix}/jquery-3.7.1/jquery-3.7.1.min.js')
  script(type='text/javascript', src='#{prefix}/jquery-3.7.1/jquery-migrate-3.6.0.js')
  script(type='text/javascript', src='#{prefix}/bootstrap/js/bootstrap.min.js')
  script(type='text/javascript', src='#{prefix}/dependencies/moment.js')
