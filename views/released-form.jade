extends default-buttons

block head
  meta(charset='urf-8')
  title #{orgName} - templates - #{id} - preview
  meta(name='viewport', content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet', href='#{prefix}/bootstrap/css/bootstrap.css')
  link(rel='stylesheet', href='#{prefix}/bootstrap/css/bootstrap-responsive.css')
  link(rel='stylesheet', href='#{prefix}/font-awesome-4.3.0/css/font-awesome.css')
  link(rel='stylesheet', href='#{prefix}/stylesheets/style.css')

block bodyJs
  script(type='text/javascript').
    var title = !{JSON.stringify(title)};

prepend topBtn
  .btn-group

block underTopBtn
  .container
    #message
    .row
      .span9
        h3 !{title}
        h4 type: #{formType}
        h4 status: #{statusText}
        h4 version:&nbsp;
          span#version #{ver}
        if (review)
          //- h4 Reviews
          #reviews.accordion
            .accordion-group
              .accordion-heading
                a.accordion-toggle(data-toggle="collapse" data-parent="#reviews" href="#review-results") #{review.reviewResults.length} review result(s)
              #review-results.accordion-body.collapse
                .accordion-inner
                  each result in review.reviewResults
                    accordion(id="#{result._id}")
                      .accordion-group
                        .accordion-heading
                          a.accordion-toggle(data-toggle="collapse" data-parent="#{result._id}" href="\##{result._id}-comment") #{result.reviewerName || result.reviewerId}
                            | &nbsp;
                            if (result.result === "1")
                              | approved
                            | &nbsp;version #{result.v} on&nbsp;
                            span.time #{result.submittedOn}

                        .accordion-body.collapse(id="#{result._id}-comment")
                          .accordion-inner
                            span #{result.comment}
        .well-large
          if (discrepancy)
            .control-group#discrepancy-legend
              legend Discrepancy
            form.form-horizontal#discrepancy
              != discrepancy.html
          //- .control-group#discrepancy-legend
              legend Base
          form.form-horizontal#output
            != base.html
        #validation.well.hide

      .span3.sidebar
    //- .btn-group(data-toggle='buttons-radio')
      button.btn.btn-info#show-validation Show validation
      button.btn.btn-info#hide-validation.active Hide validation
    .well
      form.form-inline
        input#username.input(type='text', placeholder='Last, First', name='name')
        != ' '
        button.btn.btn-primary#notify(type='submit', data-toggle='tooltip', title='Email the user about this template') Notify
    if (isAdmin)
      if (status === 1)
        //- .btn-group
          button.btn.btn-warning#obsolete(data-toggle='tooltip', title='Obsolete the released template') Obsolete
        .btn-group
          button.btn.btn-warning#revision(data-toggle='tooltip', title='reversion the template') Start a revision

block js
  script(type='text/javascript', src='#{prefix}/jquery-3.7.1/jquery-3.7.1.min.js')
  script(type='text/javascript', src='#{prefix}/javascripts/jquery-migrate-config.js')
  script(type='text/javascript', src='#{prefix}/jquery-3.7.1/jquery-migrate-3.6.0.js')
  script(type='text/javascript', src='#{prefix}/bootstrap/js/bootstrap.min.js')
  script(type='text/javascript', src='#{prefix}/javascripts/validation.js')
  script(type='text/javascript', src='#{prefix}/dependencies/moment.js')
  script(type='text/javascript', src='#{prefix}/dependencies/livestamp.js')
  script(type='text/javascript', src='#{prefix}/javascripts/util.js')
  script(type='text/javascript', src='#{prefix}/javascripts/ajax-helper.js')
  script(type='text/javascript', src='#{prefix}/dependencies/typeahead.bundle.js')
  script(type='text/javascript', src='#{prefix}/javascripts/global.js')
  script(type='text/javascript', src='#{prefix}/javascripts/usernames.js')
  script(type='text/javascript', src='#{prefix}/javascripts/form-viewer.js')
  script(type='text/javascript', src='#{prefix}/javascripts/tracking.js')
  script(type='text/javascript', src='#{prefix}/javascripts/released-form-management.js')