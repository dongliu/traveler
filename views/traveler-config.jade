extends layout

block head
  meta(charset='urf-8')
  title #{orgName} - traveler - #{traveler._id} - config
  meta(name='viewport', content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet', href='#{prefix}/bootstrap/css/bootstrap.css')
  link(rel='stylesheet', href='#{prefix}/bootstrap/css/bootstrap-responsive.css')
  link(rel='stylesheet', href='#{prefix}/font-awesome-4.3.0/css/font-awesome.css')
  link(rel='stylesheet', href='#{prefix}/stylesheets/style.css')

block content
  - var deviceDisplay = traveler.device || ((traveler.devices && traveler.devices.length > 0) ? traveler.devices.join('/') : '');
  .container
    #message
    h3 Title:
      = ' '
      if (locals.traveler.title == undefined)
        span#title.editable No title
      else
        span#title.editable !{traveler.title}
      = ' '
      button.btn.btn-primary.editable Edit
    h4 Description:
      = ' '
      if (locals.traveler.description == undefined)
        span#description.editable No description
      else
        span#description.editable !{traveler.description}
      = ' '
      button.btn.btn-primary.editable Edit
    if (isAdmin || traveler.status < 2)
      h4 Subsystem:
        = ' '
        if (locals.traveler.subsystem == undefined || traveler.subsystem === '')
          span#subsystem.editable No subsystem
        else
          span#subsystem.editable !{traveler.subsystem}
        = ' '
        button.btn.btn-primary.editable Edit
      h4 Device:
        = ' '
        if (deviceDisplay === '')
          span#device.editable No device
        else
          span#device.editable !{deviceDisplay}
        = ' '
        button.btn.btn-primary.editable Edit
      h4 Activity:
        = ' '
        if (locals.traveler.activity == undefined || traveler.activity === '')
          span#activity.editable No activity
        else
          span#activity.editable !{traveler.activity}
        = ' '
        button.btn.btn-primary.editable Edit
      h4 Machine Area:
        = ' '
        if (locals.traveler.machineArea == undefined || traveler.machineArea === '')
          span#machineArea.editable No machine area
        else
          span#machineArea.editable !{traveler.machineArea}
        = ' '
        button.btn.btn-primary.editable Edit
      h4 Sector:
        = ' '
        if (locals.traveler.sector == undefined || traveler.sector === '')
          span#sector.editable No sector
        else
          span#sector.editable !{traveler.sector}
        = ' '
        button.btn.btn-primary.editable Edit
      h4 Product Windchill ID:
        = ' '
        if (locals.traveler.windchillId == undefined || traveler.windchillId === '')
          span#windchillId.editable No Windchill ID
        else
          span#windchillId.editable !{traveler.windchillId}
        = ' '
        button.btn.btn-primary.editable Edit
    else
      h4 Subsystem: #{traveler.subsystem}
      h4 Device: #{deviceDisplay}
      h4 Activity: #{traveler.activity}
      h4 Machine Area: #{traveler.machineArea}
      h4 Sector: #{traveler.sector}
      h4 Product Windchill ID: #{traveler.windchillId}
    p Created on
      = ' '
      span.time #{traveler.createdOn}
    if (locals.traveler.updatedOn != undefined)
      p Updated by #{traveler.updatedBy} on
        = ' '
        span.time #{traveler.updatedOn}
    h4 Status:
      = ' '
      case traveler.status
        when 0
          | initialized
        when 1
          | active
        when 1.5
          | submitted for completion
        when 2
          | completed
        when 3
          | frozen
    //- h4 Locations
    //- ul#locations
      each location in traveler.locations
        li
          span.location #{location}
          = ' '
          button.btn.btn-small.btn-warning.removeLocation
            i.fa.fa-trash-o.fa-lg
    h4 Tags
    ul#tags.tag-list
      each tag in traveler.tags
        li
          span.tag #{tag}
          = ' '
          button.btn.btn-small.btn-warning.remove-tag
            i.fa.fa-trash-o.fa-lg
    br
    .btn-group
      button.btn.btn-primary#add-tag
        i.fa.fa-tag.fa-lg
        | &nbsp;Add tag
    br
    br
    if (viewConfig.showCCDB)
      .btn-group
          a.btn.btn-info(href='#{prefix}/devices/', target='#{viewConfig.linkTarget}') Browse devices

block js
  script(type='text/javascript', src='#{prefix}/jquery-3.7.1/jquery-3.7.1.min.js')
  script(type='text/javascript', src='#{prefix}/javascripts/jquery-migrate-config.js')
  script(type='text/javascript', src='#{prefix}/jquery-3.7.1/jquery-migrate-3.6.0.js')
  script(type='text/javascript', src='#{prefix}/bootstrap/js/bootstrap.js')
  script(type='text/javascript', src='#{prefix}/jquery/jquery.jeditable.js')
  script(type='text/javascript', src='#{prefix}/dependencies/moment.js')
  script(type='text/javascript', src='#{prefix}/javascripts/ajax-helper.js')
  script(type='module', src='#{prefix}/javascripts/traveler-config.js')
