# NCR Workflow Configuration
# Copy this file to .env and adjust values for your environment.
# .env is gitignored — never commit real secrets.

COMPOSE_PROJECT_NAME=upton-ncr
WEB_PORT=3201
API_PORT=3202
MONGO_EXPRESS_PORT=8281
MAIL_PORT=8025

# E2E test credentials — used by the test-e2e/ scripts and the e2e/ Playwright
# suite to log in to the web app
E2E_USER=your-username
E2E_PASS=your-password

# A second, distinct real login — required by the e2e/ Playwright suite's
# designated-approver scenarios (an NCR approval requires a second real
# identity, not just a role toggle on the same user). Any existing user
# document works, same as the manual test-e2e/us3-*.md convention of picking
# "any existing user document" as <approver-username>.
E2E_USER2=your-second-username
E2E_PASS2=your-second-password

