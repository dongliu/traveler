# NCR Workflow Configuration
# Copy this file to .env and adjust values for your environment.
# .env is gitignored — never commit real secrets.

# Maximum time before an NCR approval step is considered overdue (e.g. 5d, 48h)
NCR_APPROVAL_TIMEOUT=5d

# Number of times the email service retries a failed notification before marking delivery as Failed
NCR_EMAIL_RETRY_COUNT=3
