# NCR Workflow Configuration
# Copy this file to .env and adjust values for your environment.
# .env is gitignored — never commit real secrets.

COMPOSE_PROJECT_NAME=upton-ncr
WEB_PORT=3201
API_PORT=3202
MONGO_EXPRESS_PORT=8281

# E2E test credentials — used by the test-e2e/ scripts to log in to the web app
E2E_USER=your-username
E2E_PASS=your-password

